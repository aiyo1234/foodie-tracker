# Server Port
PORT=3000

# Public URL of your deployed server (used in ntfy notification action links)
BASE_URL=https://your-app-name.onrender.com

# Unique ntfy.sh notification topic (pick a private, hard-to-guess name)
NTFY_TOPIC=foodie-tracker-john-8291

# Dwell threshold to trigger notification (default: 300 seconds = 5 minutes)
DWELL_THRESHOLD_SECONDS=300

# Cooldown before prompting for the same location again (hours)
PROMPT_COOLDOWN_HOURS=12

# Home Geofence Coordinates (Ignored so you won't be prompted while at home)
HOME_LAT=
HOME_LON=
HOME_RADIUS_METERS=150

# Work Geofence Coordinates (Ignored so you won't be prompted while at the office)
WORK_LAT=
WORK_LON=
WORK_RADIUS_METERS=150
